rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --------------------------------------------------------------------------------
    // GLOBAL PRIMITIVES & HELPERS
    // --------------------------------------------------------------------------------
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    // Bootstrapped admin email
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sh2305895@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // --------------------------------------------------------------------------------
    // ENTITY VALIDATION BLUEPRINTS
    // --------------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) && data.keys().size() <= 5 &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.role in ['customer', 'admin'] &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 20));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'description', 'price', 'category', 'brand', 'sizes', 'colors', 'stock', 'images']) && data.keys().size() <= 14 &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.price is number &&
             (!('discountPrice' in data) || data.discountPrice is number) &&
             data.category is string && data.category.size() <= 100 &&
             data.brand is string && data.brand.size() <= 100 &&
             data.sizes is list && data.sizes.size() <= 20 &&
             data.colors is list && data.colors.size() <= 20 &&
             data.stock is number &&
             data.images is list && data.images.size() <= 10 && (data.images.size() == 0 || data.images[0] is string) &&
             (!('featured' in data) || data.featured is bool) &&
             (!('rating' in data) || data.rating is number) &&
             (!('reviews' in data) || data.reviews is number);
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'items', 'shippingAddress', 'paymentMethod', 'subtotal', 'shippingFee', 'total', 'status', 'date']) && data.keys().size() <= 12 &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.items is list && data.items.size() <= 50 &&
             data.shippingAddress is map &&
             data.paymentMethod is string && data.paymentMethod.size() <= 50 &&
             (!('paymentDetails' in data) || data.paymentDetails is map) &&
             data.subtotal is number &&
             data.shippingFee is number &&
             (!('discount' in data) || data.discount is number) &&
             data.total is number &&
             data.status in ['Pending Verification', 'Processing', 'Shipped', 'Delivered', 'Cancelled'] &&
             data.date is string && data.date.size() <= 50;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name']) && data.keys().size() == 2 &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'userName', 'rating', 'comment', 'date', 'status']) && data.keys().size() == 8 &&
             data.id is string && data.id.size() <= 128 &&
             data.productId is string && data.productId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 100 &&
             data.rating is number &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.date is string && data.date.size() <= 50 &&
             data.status in ['Pending', 'Approved'];
    }

    // --------------------------------------------------------------------------------
    // PATH MATCHERS & ACCESS CONTROL
    // --------------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isValidId(userId) && isSignedIn() && 
                    request.auth.uid == userId && 
                    isValidUser(incoming()) && 
                    incoming().id == userId &&
                    (incoming().role == 'customer' || isAdmin()); // Only admin can create another admin

      allow update: if isValidId(userId) && isSignedIn() && (
                      isAdmin() || (
                        request.auth.uid == userId && 
                        isValidUser(incoming()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone'])
                      )
                    );
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming()) && incoming().id == productId;
      allow update: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow delete: if isValidId(productId) && isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      
      allow create: if isValidId(orderId) && isSignedIn() && 
                    isValidOrder(incoming()) && 
                    incoming().id == orderId &&
                    incoming().userId == request.auth.uid &&
                    (incoming().status == 'Pending Verification' || incoming().status == 'Processing');

      allow update: if isValidId(orderId) && isSignedIn() && (
                      isAdmin() || (
                        existing().userId == request.auth.uid &&
                        isValidOrder(incoming()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                        incoming().status == 'Cancelled' &&
                        existing().status in ['Pending Verification', 'Processing']
                      )
                    );
      allow delete: if false; // Orders should not be deleted, only cancelled
    }

    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow create: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming()) && incoming().id == categoryId;
      allow update: if isValidId(categoryId) && isAdmin() && isValidCategory(incoming());
      allow delete: if isValidId(categoryId) && isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (isAdmin() || existing().status == 'Approved' || (isSignedIn() && existing().userId == request.auth.uid));
      allow list: if isAdmin() || resource.data.status == 'Approved' || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isValidId(reviewId) && isSignedIn() && 
                    isValidReview(incoming()) && 
                    incoming().id == reviewId &&
                    incoming().userId == request.auth.uid &&
                    incoming().status == 'Pending' &&
                    exists(/databases/$(database)/documents/products/$(incoming().productId));

      allow update: if isValidId(reviewId) && isSignedIn() && (
                      isAdmin() || (
                        existing().userId == request.auth.uid &&
                        isValidReview(incoming()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment', 'date'])
                      )
                    );
      allow delete: if isValidId(reviewId) && isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
    }
  }
}
